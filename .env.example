# Copy to .env (git-ignored). Server reads this file; never commit real values.
# In development every third-party key is optional so the server boots before
# accounts exist. In production (NODE_ENV=production) all are required.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase — local defaults print from `npm run db:start`; hosted values are in
# Dashboard > Project Settings > API. SERVICE ROLE KEY IS SERVER-ONLY.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Helius — dashboard.helius.dev > API Keys
HELIUS_API_KEY=
# Any long random string; set the same value as the webhook's auth header in Helius.
# Generate: openssl rand -hex 32
HELIUS_WEBHOOK_SECRET=

# Birdeye — bds.birdeye.so (free tier)
BIRDEYE_API_KEY=
