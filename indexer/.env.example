# Copy to indexer/.env.local (git-ignored). Server-side only; never commit real values.

# BSC JSON-RPC endpoint. Provider keys are fine here, and only here.
BSC_RPC_URL=

# Postgres connection string. Leave empty in development to use Ponder's embedded PGlite.
DATABASE_URL=

# First block to index. Leave empty to start from the chain head (new launches and
# their trades only). For the full history, set the Brew factory's deployment block;
# backfilling needs an RPC that serves old logs, which free public endpoints do not.
START_BLOCK=
