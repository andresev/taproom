# Copy to indexer/.env.local (git-ignored). Server-side only; never commit real values.

# BSC JSON-RPC endpoint. Provider keys are fine here, and only here. For history,
# a keyed endpoint that serves old logs, e.g. https://bsc-mainnet.nodereal.io/v1/<key>.
BSC_RPC_URL=

# Postgres connection string. Leave empty in development to use Ponder's embedded PGlite.
DATABASE_URL=

# First block to index. Leave empty to start from the chain head (new launches and
# their trades only). For the full history, set 120201671, the standard factory's
# deployment block; later factories are indexed from their own. Backfilling needs an
# RPC that serves old logs, which free public endpoints do not, and the Ponder
# patches in patches/ (docs/0012, docs/0016).
START_BLOCK=
