# Copy to app/.env. EXPO_PUBLIC_* values are bundled into the app binary and are
# PUBLIC. Only the Supabase anon key and keyless URLs go here — never the
# service-role key, an RPC provider key, or any other secret.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The next two are not read by the app since docs/0007 removed external wallet
# connection. They stay until the external-wallet question in CLAUDE.md is settled.
# Reown (WalletConnect) project ID from https://dashboard.reown.com. Public by design.
EXPO_PUBLIC_REOWN_PROJECT_ID=
# The app's public origin. It was used in the wallet connection metadata and as the
# URI of the Sign in with Ethereum message, so it had to be the Supabase site URL or
# one of its allowed redirect URLs.
EXPO_PUBLIC_APP_URL=http://localhost:3000
# Privy (embedded wallet) app ID and app client ID, from dashboard.privy.io. Both are
# public. The Privy app SECRET is server-side only and must never go in this file.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Development only: set to true to open the app without signing in while Google and
# Apple sign-in are being set up. Ignored in release builds.
EXPO_PUBLIC_SKIP_SIGN_IN=
# Indexer HTTP API (npm run dev:indexer).
EXPO_PUBLIC_INDEXER_URL=http://localhost:42069
# Public receipt pages (docs/0010): the site that serves the indexer's /r/:id route,
# printed on each receipt card with a QR code. Leave empty and cards carry no link.
# In development, the indexer itself: http://localhost:42069
EXPO_PUBLIC_RECEIPT_PAGE_URL=
# Optional keyless BSC RPC; defaults to viem's public BSC endpoint.
EXPO_PUBLIC_BSC_RPC_URL=
